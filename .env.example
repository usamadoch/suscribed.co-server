# Server Environment Variables
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB Atlas (use your connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/patreon_mvp?retryWrites=true&w=majority

# JWT Secrets (generate secure secrets in production)
JWT_ACCESS_SECRET=your_access_secret_key_here_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_here_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth (optional, configure when needed)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Cookie Settings
COOKIE_SECRET=your_cookie_secret_here_change_in_production

# Upstash Redis (get from Upstash dashboard)
# REST URL and Token for cache operations
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here
# Redis URL for BullMQ and rate limiting
UPSTASH_REDIS_URL=redis://default:your_password@your-redis.upstash.io:6379

# Feature Flags
FEATURE_REDIS_CACHE=true
FEATURE_BACKGROUND_JOBS=true
FEATURE_AUDIT_LOGS=true

# Logging
LOG_LEVEL=info
